{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "daneshyar",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "daneshyar-files"
    }
  ]
}
